        {
          "property": "opacity",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.15,
              "value": 0,
              "easing": "quartInOut"
            },
            {
              "time": 0.45,
              "value": 1,
              "easing": "quartInOut"
            }
          ]
        },
        {
          "property": "translate_y",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.15,
              "value": -0.015,
              "easing": "expoOut"
            },
            {
              "time": 0.6,
              "value": 0,
              "easing": "expoOut"
            }
