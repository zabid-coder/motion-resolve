        {
          "property": "opacity",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.52,
              "value": 0,
              "easing": "quartInOut"
            },
            {
              "time": 0.92,
              "value": 1,
              "easing": "quartInOut"
            }
          ]
        },
        {
          "property": "translate_y",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.52,
              "value": -0.01,
              "easing": "expoOut"
            },
            {
              "time": 1.07,
              "value": 0,
              "easing": "expoOut"
            }
          ]
        },
        {
          "property": "opacity",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.0,
              "value": 1,
              "easing": "cubicIn"
            },
            {
              "time": 0.25,
              "value": 0,
              "easing": "cubicIn"
            }
          ]
