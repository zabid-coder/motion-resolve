{
  "id": "saas_bento_grid",
  "name": "Bento Feature Grid",
  "category": "SaaS / Tech",
  "tier": "premium",
  "description": "Apple / Linear product bento cell label with category tag.",
  "tags": [
    "saas",
    "bento",
    "feature",
    "product"
  ],
  "duration_default": 4.5,
  "min_hold": 2.0,
  "in_duration": 0.6,
  "out_duration": 0.35,
  "parameters": [
    {
      "id": "bento_title",
      "name": "Feature Name",
      "type": "string",
      "default": "AUTOMATED TIMELINE SYNC",
      "category": "Text"
    },
    {
      "id": "bento_cat",
      "name": "Category",
      "type": "string",
      "default": "INTELLIGENT WORKFLOW",
      "category": "Text"
    },
    {
      "id": "pos_y",
      "name": "Vertical Position",
      "type": "number",
      "default": 0.5,
      "min_val": 0.1,
      "max_val": 0.85,
      "step": 0.01,
      "category": "Layout"
    }
  ],
  "layers": [
    {
      "id": "bento_card",
      "type": "shape_rect",
      "name": "Bento Plate",
      "props": {
        "role": "plate",
        "width": 0.7,
        "height": 0.24,
        "corner_radius": 14,
        "color": "token:bg_plate",
        "border": "token:border",
        "border_color": "token:border",
        "border_width": 0.7,
        "center_x": 0.5,
        "center_y": "param:pos_y"
      },
      "motion_tracks": [
        {
          "property": "opacity",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.0,
              "value": 0,
              "easing": "quartInOut"
            },
            {
              "time": 0.3,
              "value": 1,
              "easing": "quartInOut"
            }
          ]
        },
        {
          "property": "scale",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.0,
              "value": 0.92,
              "easing": "softSpring"
            },
            {
              "time": 0.6,
              "value": 1,
              "easing": "expoOut"
            }
          ]
        },
        {
          "property": "translate_y",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.0,
              "value": -0.02,
              "easing": "expoOut"
            },
            {
              "time": 0.6,
              "value": 0,
              "easing": "expoOut"
            }
          ]
        },
        {
          "property": "scale",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.1,
              "value": 1,
              "easing": "expoIn"
            },
            {
              "time": 0.45,
              "value": 0.96,
              "easing": "expoOut"
            }
          ]
        },
        {
          "property": "opacity",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.15,
              "value": 1,
              "easing": "cubicIn"
            },
            {
              "time": 0.45,
              "value": 0,
              "easing": "cubicIn"
            }
          ]
        }
      ]
    },
    {
      "id": "title",
      "type": "text",
      "name": "Title",
      "props": {
        "text": "param:bento_title",
        "font": "Avenir Next",
        "size": 0.055,
        "weight": "Demi",
        "color": "token:text_primary",
        "character_spacing": 1.04,
        "text_width": 0.58,
        "font_bn": "token:font_heading_bn",
        "role": "headline",
        "alignment": "left",
