{
  "id": "kin_word_pop",
  "name": "Stroboscopic Word Pop",
  "category": "Kinetic, Restrained",
  "tier": "free",
  "description": "Fast-paced kinetic word pop with instantaneous entrance.",
  "tags": [
    "kinetic",
    "word pop",
    "impact",
    "fast",
    "punchy"
  ],
  "duration_default": 3.0,
  "min_hold": 1.2,
  "in_duration": 0.5,
  "out_duration": 0.32,
  "parameters": [
    {
      "id": "word",
      "name": "Impact Word",
      "type": "string",
      "default": "UNSTOPPABLE",
      "category": "Text"
    },
    {
      "id": "pos_y",
      "name": "Vertical Position",
      "type": "number",
      "default": 0.5,
      "min_val": 0.1,
      "max_val": 0.85,
      "step": 0.01,
      "category": "Layout"
    }
  ],
  "layers": [
    {
      "id": "word",
      "type": "text",
      "name": "Word",
      "props": {
        "text": "param:word",
        "size": 0.09,
        "font": "Avenir Next Condensed",
        "weight": "Bold",
        "font_bn": "token:font_heading_bn",
        "role": "headline",
        "character_spacing": 1.0,
        "alignment": "center",
        "text_width": 0.76,
        "stagger": {
          "delay": 1.0
        }
      },
      "motion_tracks": [
        {
          "property": "opacity",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.0,
              "value": 0,
              "easing": "linear"
            },
            {
              "time": 0.08,
              "value": 1,
              "easing": "linear"
            }
          ]
        },
        {
          "property": "scale",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.0,
              "value": 0.3,
              "easing": "spring"
            },
            {
              "time": 0.5,
              "value": 1.0,
              "easing": "expoOut"
            }
          ]
        },
        {
          "property": "opacity",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.05,
              "value": 1,
              "easing": "cubicIn"
            },
            {
              "time": 0.25,
              "value": 0,
              "easing": "cubicIn"
            }
          ]
        },
        {
          "property": "scale",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.0,
              "value": 1,
              "easing": "expoIn"
            },
            {
              "time": 0.25,
              "value": 0.8,
              "easing": "expoOut"
            }
          ]
        }
      ]
    }
  ],
  "aspect_ratios": [
    "16:9",
    "9:16",
    "1:1"
  ]
}