{
  "id": "kin_word_pop",
  "name": "Stroboscopic Word Pop",
  "category": "Kinetic, Restrained",
  "description": "Fast-paced kinetic word pop with instantaneous entrance.",
  "tags": [
    "kinetic",
    "word pop",
    "impact",
    "fast",
    "punchy"
  ],
  "duration_default": 3.0,
  "min_hold": 1.2,
  "in_duration": 0.45,
  "out_duration": 0.28,
  "parameters": [
    {
      "id": "word",
      "name": "Impact Word",
      "type": "string",
      "default": "UNSTOPPABLE",
      "category": "Text"
    },
    {
      "id": "pos_y",
      "name": "Vertical Position",
      "type": "number",
      "default": 0.5,
      "min_val": 0.1,
      "max_val": 0.85,
      "step": 0.01,
      "category": "Layout"
    }
  ],
  "layers": [
    {
      "id": "word",
      "type": "text",
      "name": "Word",
      "props": {
        "text": "param:word",
        "size": 0.09
      },
      "motion_tracks": [
        {
          "property": "opacity",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.06,
              "value": 0.0,
              "easing": "quartInOut"
            },
            {
              "time": 0.3,
              "value": 1.0,
              "easing": "quartInOut"
            }
          ]
        },
        {
          "property": "translate_y",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.06,
              "value": -0.035,
              "easing": "expoOut"
            },
            {
              "time": 0.44,
              "value": 0.0,
              "easing": "expoOut"
            }
          ]
        },
        {
          "property": "translate_y",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.0,
              "value": 0.0,
              "easing": "cubicIn"
            },
            {
              "time": 0.3,
              "value": -0.04,
              "easing": "cubicIn"
            }
          ]
        },
        {
          "property": "opacity",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.0,
              "value": 1.0,
              "easing": "cubicIn"
            },
            {
              "time": 0.3,
              "value": 0.0,
              "easing": "cubicIn"
            }
          ]
        }
      ]
    }
  ],
  "aspect_ratios": [
    "16:9",
    "9:16",
    "1:1"
  ]
}