{
  "id": "kin_split_reveal",
  "name": "Split-Seam Razor Reveal",
  "category": "Kinetic, Restrained",
  "description": "Top headline slides up from a razor-sharp horizontal seam line while bottom subline slides down in opposite choreography.",
  "tags": [
    "kinetic",
    "split",
    "seam",
    "razor",
    "editorial",
    "headline"
  ],
  "aspect_ratios": [
    "16:9",
    "9:16",
    "1:1"
