          ]
        },
        {
          "property": "translate_y",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.0,
              "value": 0,
              "easing": "cubicIn"
            },
            {
              "time": 0.3,
              "value": -0.01,
              "easing": "cubicIn"
            }
          ]
        }
      ]
