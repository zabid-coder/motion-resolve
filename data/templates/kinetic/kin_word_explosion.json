        "center_x": 0.50,
        "center_y": "param:pos_y"
      },
      "motion_tracks": [
        {
          "property": "scale",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.0,
              "value": 0.70,
              "easing": "quartInOut"
            },
            {
              "time": 0.22,
              "value": 1.05,
