{
  "id": "kin_word_explosion",
  "name": "Viral Kinetic Pop & Expanding Pill",
  "category": "Kinetic, Restrained",
  "description": "High-retention kinetic explosion with fast scale pop, expanding neon boundary pill, and snappy snap-back.",
  "tags": [
    "kinetic",
    "viral",
    "pop",
    "pill",
    "explosion",
    "retention"
  ],
  "aspect_ratios": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "duration_default": 3.4,
  "min_hold": 1.6,
  "in_duration": 0.45,
  "out_duration": 0.28,
  "parameters": [
    {
      "id": "keyword",
      "name": "Keyword Punch",
      "type": "string",
      "default": "UNBELIEVABLE",
      "category": "Text"
    },
    {
      "id": "tagline",
      "name": "Context Tagline",
      "type": "string",
      "default": "THIS CHANGES EVERYTHING",
      "category": "Text"
    },
    {
      "id": "pill_color",
      "name": "Pill Accent",
      "type": "color",
      "default": [
        1.0,
        0.90,
        0.0,
        0.95
      ],
      "category": "Style"
    },
    {
      "id": "pos_y",
      "name": "Vertical Position",
      "type": "number",
      "default": 0.50,
      "min_val": 0.15,
      "max_val": 0.85,
      "step": 0.01,
      "category": "Layout"
    }
  ],
  "layers": [
