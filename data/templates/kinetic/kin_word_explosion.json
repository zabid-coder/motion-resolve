{
  "id": "kin_word_explosion",
  "name": "Viral Kinetic Pop & Expanding Pill",
  "category": "Kinetic, Restrained",
  "description": "High-retention kinetic explosion with fast scale pop, expanding neon boundary pill, and snappy snap-back.",
  "tags": [
    "kinetic",
    "viral",
    "pop",
    "pill",
    "explosion",
    "retention"
  ],
  "aspect_ratios": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "duration_default": 3.4,
  "min_hold": 1.6,
  "in_duration": 0.5,
  "out_duration": 0.32,
  "parameters": [
    {
      "id": "keyword",
      "name": "Keyword Punch",
      "type": "string",
      "default": "UNBELIEVABLE",
      "category": "Text"
    },
    {
      "id": "tagline",
      "name": "Context Tagline",
      "type": "string",
      "default": "THIS CHANGES EVERYTHING",
      "category": "Text"
    },
    {
      "id": "pill_color",
      "name": "Pill Accent",
      "type": "color",
      "default": [
        1.0,
        0.9,
        0.0,
        0.95
      ],
      "category": "Style"
    },
    {
      "id": "pos_y",
      "name": "Vertical Position",
      "type": "number",
      "default": 0.5,
      "min_val": 0.15,
      "max_val": 0.85,
      "step": 0.01,
      "category": "Layout"
    }
  ],
  "layers": [
    {
      "id": "boundary_pill",
      "type": "shape_pill",
      "name": "Boundary Pill",
      "props": {
        "width": 0.68,
        "height": 0.14,
        "color": "param:pill_color",
        "corner_radius": 14,
        "role": "plate",
        "center_x": 0.5,
        "center_y": "param:pos_y"
      },
      "motion_tracks": [
        {
          "property": "opacity",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.0,
              "value": 0,
              "easing": "quartInOut"
            },
            {
              "time": 0.34,
              "value": 1,
              "easing": "quartInOut"
            }
          ]
        },
        {
          "property": "scale_x",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.0,
              "value": 0.96,
              "easing": "quartInOut"
            },
            {
              "time": 0.5,
              "value": 1,
              "easing": "expoOut"
            }
          ]
        },
        {
          "property": "opacity",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.0,
              "value": 1,
              "easing": "cubicIn"
            },
            {
              "time": 0.32,
              "value": 0,
              "easing": "cubicIn"
            }
          ]
        }
      ]
    },
    {
      "id": "keyword_punch",
