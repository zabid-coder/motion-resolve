          "phase": "in",
          "keyframes": [
            {
              "time": 0.065,
              "value": 0,
              "easing": "quartInOut"
            },
            {
              "time": 0.325,
              "value": 1,
              "easing": "expoOut"
            }
          ]
        },
        {
          "property": "translate_y",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.065,
              "value": 0.018,
              "easing": "expoOut"
            },
            {
