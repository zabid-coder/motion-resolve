{
  "id": "cine_chapter_card",
  "name": "Cinematic Chapter Card",
  "category": "Cinematic",
  "tier": "premium",
  "description": "Slow, wide, patient chapter card with fine divider line and wide-tracked title.",
  "tags": [
    "cinematic",
    "film",
    "chapter",
    "slow",
    "wide tracking"
  ],
  "aspect_ratios": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "duration_default": 5.0,
  "min_hold": 2.5,
  "in_duration": 0.65,
  "out_duration": 0.4,
  "parameters": [
    {
      "id": "chapter",
      "name": "Chapter Numeral",
      "type": "string",
      "default": "CHAPTER I",
      "category": "Text"
    },
    {
      "id": "title",
      "name": "Chapter Title",
      "type": "string",
      "default": "THE RETURN TO NATURE",
      "category": "Text"
    },
    {
      "id": "pos_y",
      "name": "Vertical Position",
      "type": "number",
      "default": 0.5,
      "min_val": 0.1,
      "max_val": 0.85,
      "step": 0.01,
      "category": "Layout"
    }
  ],
