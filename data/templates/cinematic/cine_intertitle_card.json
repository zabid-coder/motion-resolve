{
  "id": "cine_intertitle_card",
  "name": "Film Intertitle Card",
  "category": "Cinematic",
  "tier": "premium",
  "description": "Classic dramatic film narrative card with centered statement.",
  "tags": [
    "cinematic",
    "intertitle",
    "narrative",
    "film"
  ],
  "duration_default": 5.5,
  "min_hold": 2.8,
  "in_duration": 0.65,
  "out_duration": 0.4,
  "parameters": [
    {
      "id": "card_text",
      "name": "Narrative Text",
      "type": "string",
      "default": "THREE YEARS LATER",
      "category": "Text"
    },
    {
      "id": "pos_y",
      "name": "Vertical Position",
      "type": "number",
      "default": 0.5,
      "min_val": 0.1,
      "max_val": 0.85,
      "step": 0.01,
      "category": "Layout"
    }
  ],
  "layers": [
    {
      "id": "card",
      "type": "text",
      "name": "Card",
      "props": {
        "text": "param:card_text",
        "size": 0.08,
        "font": "Baskerville",
        "weight": "Regular",
        "font_bn": "token:font_heading_bn",
        "role": "headline",
        "character_spacing": 1.0,
        "alignment": "center",
        "text_width": 0.76,
        "stagger": {
          "delay": 1.3
        }
      },
      "motion_tracks": [
        {
          "property": "opacity",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.0,
              "value": 0,
              "easing": "quartInOut"
            },
            {
              "time": 0.35,
              "value": 1,
              "easing": "quartInOut"
            }
          ]
        },
        {
          "property": "translate_y",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.0,
              "value": -0.02,
              "easing": "expoOut"
            },
            {
              "time": 0.5,
              "value": 0,
              "easing": "expoOut"
            }
          ]
        },
        {
          "property": "blur",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.0,
              "value": 6.0,
              "easing": "expoOut"
            },
            {
              "time": 0.45,
              "value": 0,
              "easing": "expoOut"
            }
          ]
        },
        {
          "property": "opacity",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.0,
              "value": 1,
              "easing": "cubicIn"
            },
            {
              "time": 0.3,
              "value": 0,
              "easing": "cubicIn"
            }
          ]
        }
      ]
    }
  ],
  "aspect_ratios": [
    "16:9",
    "9:16",
    "1:1"
  ]
}