{
  "id": "edit_issue_tag",
  "name": "Issue / Number Tag",
  "category": "Editorial / Magazine",
  "tier": "free",
  "description": "Monochrome volume / issue tag with date indicator.",
  "tags": [
    "editorial",
    "issue",
    "volume",
    "date"
  ],
  "duration_default": 4.0,
  "min_hold": 1.8,
  "in_duration": 0.64,
  "out_duration": 0.34,
  "parameters": [
    {
      "id": "issue",
      "name": "Issue Number",
      "type": "string",
      "default": "VOL. 08 // ISSUE 24",
      "category": "Text"
    },
    {
      "id": "topic",
      "name": "Issue Topic",
      "type": "string",
      "default": "THE ARCHITECTURAL RENAISSANCE",
      "category": "Text"
    },
    {
      "id": "pos_y",
      "name": "Vertical Position",
      "type": "number",
      "default": 0.26,
      "min_val": 0.1,
      "max_val": 0.85,
      "step": 0.01,
      "category": "Layout"
    }
  ],
  "layers": [
    {
      "id": "topic",
      "type": "text",
      "name": "Topic",
      "props": {
        "text": "param:topic",
        "size": 0.052,
        "text_width": 0.82,
        "alignment": "center",
        "font": "Baskerville",
        "weight": "Regular",
        "font_bn": "token:font_heading_bn",
        "role": "headline",
        "character_spacing": 1.0,
        "stagger": {
          "delay": 1.3
        }
      },
      "motion_tracks": [
        {
          "property": "opacity",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.0,
              "value": 0,
              "easing": "quartInOut"
            },
            {
              "time": 0.35,
              "value": 1,
              "easing": "quartInOut"
            }
          ]
        },
        {
          "property": "translate_y",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.0,
              "value": -0.02,
              "easing": "expoOut"
            },
            {
              "time": 0.5,
              "value": 0,
              "easing": "expoOut"
            }
          ]
        },
        {
          "property": "blur",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.0,
              "value": 6.0,
              "easing": "expoOut"
            },
            {
              "time": 0.45,
              "value": 0,
              "easing": "expoOut"
            }
          ]
        },
        {
          "property": "opacity",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.0,
              "value": 1,
              "easing": "cubicIn"
            },
            {
              "time": 0.3,
              "value": 0,
              "easing": "cubicIn"
            }
          ]
        }
      ]
    },
    {
      "id": "issue",
      "type": "text",
      "name": "Issue",
      "props": {
        "text": "param:issue",
        "size": 0.04,
        "font": "Menlo",
        "weight": "Medium",
        "font_bn": "token:font_heading_bn",
        "role": "eyebrow",
        "character_spacing": 1.08,
        "alignment": "left",
        "text_width": 0.64
      },
      "motion_tracks": [
        {
          "property": "opacity",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.57,
              "value": 0,
              "easing": "quartInOut"
            },
            {
              "time": 1.02,
              "value": 1,
              "easing": "quartInOut"
            }
          ]
        },
        {
          "property": "opacity",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.0,
              "value": 1,
              "easing": "cubicIn"
            },
            {
              "time": 0.25,
              "value": 0,
              "easing": "cubicIn"
            }
          ]
        }
      ]
    },
    {
      "id": "line",
      "type": "shape_line",
      "name": "Line",
      "props": {
        "width": 0.2,
        "height": 0.003,
        "color": "token:accent",
        "origin": "left"
      },
      "motion_tracks": [
        {
          "property": "opacity",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.0,
              "value": 0,
              "easing": "linear"
            },
            {
              "time": 0.06,
              "value": 1,
              "easing": "linear"
            }
          ]
        },
        {
          "property": "scale_x",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.0,
              "value": 0,
              "easing": "expoInOut"
            },
            {
              "time": 0.6,
              "value": 1,
              "easing": "expoOut"
            }
          ]
        },
        {
          "property": "scale_x",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.1,
              "value": 1,
              "easing": "expoIn"
            },
            {
              "time": 0.42,
              "value": 0,
              "easing": "expoOut"
            }
          ]
        },
        {
          "property": "opacity",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.38,
              "value": 1,
              "easing": "linear"
            },
            {
              "time": 0.42,
              "value": 0,
              "easing": "linear"
            }
          ]
        }
      ]
    }
  ],
  "aspect_ratios": [
    "16:9",
    "9:16",
    "1:1"
  ]
}