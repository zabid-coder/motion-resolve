{
  "id": "pod_captions_highlight",
  "name": "Captions Moving Highlight",
  "category": "Podcast",
  "description": "Clean short-chunk caption with accent-highlighted keyword pill.",
  "tags": [
    "podcast",
    "caption",
    "highlight",
    "chunk"
  ],
  "duration_default": 3.5,
  "min_hold": 1.5,
  "in_duration": 0.45,
  "out_duration": 0.3,
  "parameters": [
    {
      "id": "caption_text",
      "name": "Caption Text",
      "type": "string",
      "default": "THIS IS WHERE EVERYTHING CHANGED",
      "category": "Text"
    },
    {
      "id": "pos_y",
      "name": "Vertical Position",
      "type": "number",
      "default": 0.24,
      "min_val": 0.1,
      "max_val": 0.85,
      "step": 0.01,
      "category": "Layout"
    }
  ],
  "layers": [
    {
      "id": "caption",
      "type": "text",
      "name": "Caption",
      "props": {
        "text": "param:caption_text",
        "size": 0.054,
        "text_width": 0.8,
        "alignment": "center"
      },
      "motion_tracks": [
        {
          "property": "opacity",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.06,
              "value": 0.0,
              "easing": "quartInOut"
            },
            {
              "time": 0.3,
              "value": 1.0,
              "easing": "quartInOut"
            }
          ]
        },
        {
          "property": "translate_y",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.06,
              "value": 0.035,
              "easing": "expoOut"
            },
            {
              "time": 0.44,
              "value": 0.0,
              "easing": "expoOut"
            }
          ]
        },
        {
          "property": "translate_y",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.0,
              "value": 0.0,
              "easing": "cubicIn"
            },
            {
              "time": 0.3,
              "value": 0.04,
              "easing": "cubicIn"
            }
          ]
        },
        {
          "property": "opacity",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.0,
              "value": 1.0,
              "easing": "cubicIn"
            },
            {
              "time": 0.3,
              "value": 0.0,
              "easing": "cubicIn"
            }
          ]
        }
      ]
    }
  ],
  "aspect_ratios": [
    "16:9",
    "9:16",
    "1:1"
  ]
}