{
  "id": "pod_quote_card",
  "name": "Quote & Clip Card",
  "category": "Podcast",
  "tier": "premium",
  "description": "Oversized quotation mark with staggered quote reveal and attribution hairline.",
  "tags": [
    "podcast",
    "quote",
    "soundbite",
    "clip"
  ],
  "duration_default": 5.5,
  "min_hold": 2.5,
  "in_duration": 0.65,
  "out_duration": 0.4,
  "parameters": [
    {
      "id": "quote_text",
      "name": "Quote Text",
      "type": "string",
      "default": "SIMPLICITY IS ABOUT SUBTRACTING THE OBVIOUS",
      "category": "Text"
    },
    {
      "id": "author",
      "name": "Attribution",
      "type": "string",
      "default": "John Maeda • Laws of Simplicity",
      "category": "Text"
    },
    {
      "id": "pos_y",
      "name": "Vertical Position",
      "type": "number",
      "default": 0.5,
      "min_val": 0.1,
      "max_val": 0.85,
      "step": 0.01,
      "category": "Layout"
    }
  ],
  "layers": [
    {
      "id": "quote_rule",
      "type": "shape_line",
      "name": "Quote Accent",
      "props": {
        "width": 0.003,
        "height": 0.14,
        "color": "token:accent",
        "center_x": 0.115,
        "center_y": "param:pos_y",
        "origin": "bottom"
      },
      "motion_tracks": [
        {
          "property": "opacity",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.5,
              "value": 0,
              "easing": "linear"
            },
            {
              "time": 0.6,
              "value": 1,
              "easing": "linear"
            }
          ]
        },
        {
          "property": "scale_y",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.5,
              "value": 0,
              "easing": "expoInOut"
            },
            {
              "time": 1.4,
              "value": 1,
              "easing": "expoOut"
            }
          ]
        },
        {
          "property": "opacity",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.0,
              "value": 1,
              "easing": "cubicIn"
            },
            {
              "time": 0.5,
              "value": 0,
              "easing": "cubicIn"
            }
          ]
        }
      ]
    },
    {
      "id": "quote",
      "type": "text",
      "name": "Quote Body",
      "props": {
        "text": "param:quote_text",
        "size": 0.036,
        "text_width": 0.72,
        "alignment": "left",
        "font": "Baskerville",
        "weight": "Regular",
        "font_bn": "token:font_heading_bn",
        "role": "headline",
        "character_spacing": 1.0,
        "center_x": 0.18,
        "center_y": "param:pos_y",
        "offset_y": 0.015
      },
      "motion_tracks": [
        {
          "property": "opacity",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.0,
              "value": 0,
              "easing": "quartInOut"
            },
            {
              "time": 0.9,
              "value": 1,
              "easing": "quartInOut"
            }
          ]
        },
        {
          "property": "blur",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.0,
              "value": 12.0,
              "easing": "expoOut"
            },
            {
              "time": 1.2,
              "value": 0,
              "easing": "expoOut"
            }
          ]
        },
        {
          "property": "tracking",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.0,
              "value": 1.35,
              "easing": "expoOut"
            },
            {
              "time": 1.6,
              "value": 1.0,
              "easing": "expoOut"
            }
          ]
        },
        {
          "property": "opacity",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.0,
              "value": 1,
              "easing": "quartInOut"
            },
            {
              "time": 0.7,
              "value": 0,
              "easing": "quartInOut"
            }
          ]
        },
        {
          "property": "blur",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.0,
              "value": 0,
              "easing": "expoIn"
            },
            {
              "time": 0.7,
              "value": 8.0,
              "easing": "expoOut"
            }
          ]
        }
      ]
    },
    {
      "id": "author",
      "type": "text",
      "name": "Author",
      "props": {
        "text": "param:author",
        "size": 0.026,
        "font": "Menlo",
        "font_bn": "token:font_body_bn",
        "role": "body",
        "character_spacing": 1.05,
        "alignment": "left",
        "text_width": 0.65,
        "weight": "Medium",
        "center_x": 0.18,
        "center_y": "param:pos_y",
        "offset_y": -0.072
      },
      "motion_tracks": [
        {
          "property": "opacity",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.85,
              "value": 0,
              "easing": "quartInOut"
            },
            {
              "time": 1.45,
              "value": 1,
              "easing": "quartInOut"
            }
          ]
        },
        {
          "property": "translate_y",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.85,
              "value": -0.01,
              "easing": "expoOut"
            },
            {
              "time": 1.65,
              "value": 0,
              "easing": "expoOut"
            }
          ]
        },
        {
          "property": "opacity",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.0,
              "value": 1,
              "easing": "cubicIn"
            },
            {
              "time": 0.5,
              "value": 0,
              "easing": "cubicIn"
            }
          ]
        }
      ]
    },
    {
      "id": "hairline",
      "type": "shape_line",
      "name": "Divider",
      "props": {
        "width": 0.1,
        "height": 0.002,
        "color": "token:accent",
        "center_x": 0.18,
        "center_y": "param:pos_y",
        "offset_y": -0.042,
        "origin": "center"
      },
      "motion_tracks": [
        {
          "property": "opacity",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.5,
              "value": 0,
              "easing": "linear"
            },
            {
              "time": 0.6,
              "value": 1,
              "easing": "linear"
            }
          ]
        },
        {
          "property": "scale_x",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.5,
              "value": 0,
              "easing": "expoInOut"
            },
            {
              "time": 1.4,
              "value": 1,
              "easing": "expoOut"
            }
          ]
        },
        {
          "property": "opacity",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.0,
              "value": 1,
              "easing": "cubicIn"
            },
            {
              "time": 0.5,
              "value": 0,
              "easing": "cubicIn"
            }
          ]
        }
      ]
    }
  ],
  "aspect_ratios": [
    "16:9",
    "9:16",
    "1:1"
  ]
}