{
  "id": "pod_quote_card",
  "name": "Quote & Clip Card",
  "category": "Podcast",
  "description": "Oversized quotation mark with staggered quote reveal and attribution hairline.",
  "tags": [
    "podcast",
    "quote",
    "soundbite",
    "clip"
  ],
  "duration_default": 5.5,
  "min_hold": 2.5,
  "in_duration": 0.65,
  "out_duration": 0.4,
  "parameters": [
    {
      "id": "quote_text",
      "name": "Quote Text",
      "type": "string",
      "default": "SIMPLICITY IS ABOUT SUBTRACTING THE OBVIOUS",
      "category": "Text"
    },
    {
      "id": "author",
      "name": "Attribution",
      "type": "string",
      "default": "John Maeda \u2022 Laws of Simplicity",
      "category": "Text"
    },
    {
      "id": "pos_y",
      "name": "Vertical Position",
      "type": "number",
      "default": 0.5,
      "min_val": 0.1,
      "max_val": 0.85,
      "step": 0.01,
      "category": "Layout"
    }
  ],
  "layers": [
    {
      "id": "quote",
      "type": "text",
      "name": "Quote Body",
      "props": {
        "text": "param:quote_text",
        "size": 0.052,
        "text_width": 0.8,
        "alignment": "center"
      },
      "motion_tracks": [
        {
          "property": "opacity",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.06,
              "value": 0.0,
              "easing": "quartInOut"
            },
            {
              "time": 0.3,
              "value": 1.0,
              "easing": "quartInOut"
            }
          ]
        },
        {
          "property": "translate_y",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.06,
              "value": -0.035,
              "easing": "expoOut"
            },
            {
              "time": 0.44,
              "value": 0.0,
              "easing": "expoOut"
            }
          ]
        },
        {
          "property": "translate_y",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.0,
              "value": 0.0,
              "easing": "cubicIn"
            },
            {
              "time": 0.3,
              "value": -0.04,
              "easing": "cubicIn"
            }
          ]
        },
        {
          "property": "opacity",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.0,
              "value": 1.0,
              "easing": "cubicIn"
