{
  "id": "pod_lower_third_slate",
  "name": "Frosted Signal — Speaker ID",
  "category": "Podcast",
  "description": "A calm, glass-inspired speaker slate with clear name/role scale, warm hairline detail, and a measured editorial reveal. Uses a translucent tint rather than heavy opaque blocks.",
  "tags": [
    "podcast",
    "lower third",
    "interview",
    "glass-inspired",
    "editorial",
    "speaker id"
  ],
  "aspect_ratios": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "duration_default": 4.2,
  "min_hold": 2.6,
  "in_duration": 0.58,
  "out_duration": 0.32,
  "parameters": [
    {
      "id": "name",
      "name": "Guest Name",
      "type": "string",
      "default": "ZARA KHAN",
      "category": "Text",
      "description": "Full name of the speaker or guest"
    },
    {
      "id": "role",
      "name": "Title / Role",
      "type": "string",
      "default": "Creative Director · Studio North",
      "category": "Text",
      "description": "Professional title or organization"
    },
    {
      "id": "social",
      "name": "Social Handle",
      "type": "string",
      "default": "@zara.studio",
      "category": "Text",
      "description": "Optional social handle or tag"
    },
    {
