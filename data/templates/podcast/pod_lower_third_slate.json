      "type": "boolean",
      "default": true,
      "category": "Style",
      "description": "Enable translucent dark backdrop plate"
    },
    {
      "id": "accent_color",
      "name": "Accent Color",
      "type": "color",
      "default": [
        0.78,
        0.56,
        0.34,
        1.0
      ],
      "category": "Style"
    },
