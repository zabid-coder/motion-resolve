        "font": "Inter",
        "weight": "SemiBold",
        "size": 0.023,
        "alignment": "left",
        "center_x": "param:pos_x",
        "offset_x": 0.05,
        "center_y": "param:pos_y",
        "offset_y": 0.011,
        "color": [
          0.98,
          0.97,
          0.95,
          1.0
        ],
        "shadow": {
          "off": true
        },
        "font_bn": "Hind Siliguri"
      },
      "motion_tracks": [
        {
          "property": "opacity",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.28,
              "value": 0,
              "easing": "quartInOut"
            },
            {
              "time": 0.6,
              "value": 1,
              "easing": "quartInOut"
            }
          ]
        },
        {
          "property": "translate_x",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.28,
              "value": -0.01,
              "easing": "expoOut"
            },
            {
              "time": 0.75,
              "value": 0,
              "easing": "expoOut"
            }
          ]
        },
        {
          "property": "opacity",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.0,
              "value": 1,
              "easing": "cubicIn"
            },
            {
              "time": 0.2,
              "value": 0,
              "easing": "cubicIn"
            }
          ]
        }
      ]
    },
    {
      "id": "detail",
      "type": "text",
      "name": "Detail",
      "props": {
        "text": "param:detail",
        "font": "Inter",
        "weight": "Medium",
        "size": 0.0155,
        "alignment": "left",
        "center_x": "param:pos_x",
        "offset_x": 0.05,
        "center_y": "param:pos_y",
        "offset_y": -0.015,
        "color": [
          0.98,
          0.97,
          0.95,
          0.52
        ],
        "shadow": {
          "off": true
        },
        "font_bn": "Hind Siliguri"
      },
      "motion_tracks": [
        {
          "property": "opacity",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.4,
              "value": 0,
              "easing": "quartInOut"
            },
            {
              "time": 0.8,
              "value": 1,
              "easing": "quartInOut"
            }
          ]
        },
        {
          "property": "translate_x",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.4,
              "value": -0.01,
