        "center_x": "param:pos_x",
        "offset_x": 0.03,
        "center_y": "param:pos_y"
      },
      "motion_tracks": [
        {
          "property": "opacity",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.05,
              "value": 0,
              "easing": "linear"
            },
            {
              "time": 0.1,
              "value": 1,
              "easing": "linear"
            }
          ]
        },
        {
          "property": "scale",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.05,
              "value": 0,
              "easing": "spring"
            },
            {
              "time": 0.5,
              "value": 1,
              "easing": "expoOut"
            }
          ]
        },
        {
          "property": "opacity",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.2,
              "value": 1,
              "easing": "cubicIn"
            },
            {
              "time": 0.35,
              "value": 0,
              "easing": "cubicIn"
            }
          ]
        }
      ]
    },
    {
      "id": "name",
      "type": "text",
      "name": "Name",
