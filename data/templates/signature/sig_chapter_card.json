{
  "id": "sig_chapter_card",
  "name": "Chapter Card",
  "category": "Signature",
  "tier": "premium",
  "description": "Chapter divider: twin rules open outward from the chapter number while a serif title settles out of blur.",
  "tags": [
    "chapter",
    "section",
    "documentary",
    "divider",
    "title",
    "signature",
    "premium"
  ],
  "aspect_ratios": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "duration_default": 5.0,
  "min_hold": 1.5,
  "in_duration": 1.5,
  "out_duration": 0.7,
  "parameters": [
    {
      "id": "chapter",
      "name": "Chapter",
      "type": "string",
      "default": "Chapter 02",
      "category": "Text"
    },
    {
      "id": "title",
      "name": "Title",
      "type": "string",
      "default": "The River Remembers",
      "category": "Text"
    },
    {
      "id": "accent_color",
      "name": "Accent",
      "type": "color",
      "default": [
        0.96,
        0.71,
        0.36,
        1.0
      ],
      "category": "Style"
    },
    {
      "id": "pos_x",
      "name": "Horizontal Anchor",
      "type": "number",
      "default": 0.5,
      "category": "Layout",
      "min_val": 0.04,
      "max_val": 0.96,
      "step": 0.005
    },
    {
      "id": "pos_y",
      "name": "Vertical Anchor",
      "type": "number",
      "default": 0.5,
      "category": "Layout",
      "min_val": 0.08,
      "max_val": 0.92,
      "step": 0.005
    }
  ],
  "layers": [
    {
      "id": "rule_l",
      "type": "shape_line",
      "name": "Left Rule",
      "props": {
        "width": 0.07,
        "height": 0.0018,
        "color": "param:accent_color",
        "center_x": "param:pos_x",
        "offset_x": -0.125,
        "center_y": "param:pos_y",
        "offset_y": 0.068,
        "origin": "right"
      },
      "motion_tracks": [
        {
          "property": "opacity",
          "phase": "in",
          "keyframes": [
