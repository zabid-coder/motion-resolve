              "time": 0.1,
              "value": 0,
              "easing": "linear"
            },
            {
              "time": 0.15,
              "value": 1,
              "easing": "linear"
            }
          ]
        },
        {
          "property": "scale_x",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.1,
              "value": 0,
              "easing": "expoInOut"
            },
            {
              "time": 0.9,
              "value": 1,
              "easing": "expoOut"
            }
          ]
        },
        {
          "property": "scale_x",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.0,
              "value": 1,
              "easing": "expoIn"
            },
            {
              "time": 0.5,
              "value": 0,
              "easing": "expoOut"
