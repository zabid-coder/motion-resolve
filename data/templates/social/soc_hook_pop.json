{
  "id": "soc_hook_pop",
  "name": "Viral Hook Pop-In",
  "category": "Social / Reels 9:16",
  "description": "Punchy 9:16 vertical hook with accent highlight box and rapid 0.18s pop-in entry.",
  "tags": [
    "social",
    "reels",
    "tiktok",
    "shorts",
    "hook",
    "viral"
  ],
  "aspect_ratios": [
    "9:16",
    "1:1",
    "16:9"
  ],
  "duration_default": 3.0,
  "min_hold": 1.5,
  "in_duration": 0.5,
  "out_duration": 0.32,
  "parameters": [
    {
      "id": "hook",
      "name": "Hook Headline",
      "type": "string",
      "default": "STOP SCROLLING",
      "category": "Text"
    },
    {
      "id": "sub",
      "name": "Follow-Up Line",
      "type": "string",
      "default": "The #1 secret to 1M views",
      "category": "Text"
    },
    {
      "id": "pos_y",
      "name": "Vertical Position",
      "type": "number",
      "default": 0.35,
      "min_val": 0.25,
      "max_val": 0.8,
      "step": 0.02,
      "category": "Layout"
    }
  ],
  "layers": [
    {
      "id": "hook_box",
      "type": "shape_rect",
      "name": "Hook Highlight Box",
      "props": {
        "width": 0.58,
        "height": 0.1,
        "color": "token:accent",
        "corner_radius": 16,
        "center_y": "param:pos_y",
        "offset_y": 0.05,
        "border_color": [
          0.26,
          0.25,
          0.34,
          0.65
        ],
        "border_width": 1.2
      },
      "motion_tracks": [
        {
          "property": "opacity",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.0,
              "value": 0,
              "easing": "quartInOut"
            },
            {
              "time": 0.34,
              "value": 1,
              "easing": "quartInOut"
            }
          ]
        },
        {
          "property": "scale_x",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.0,
              "value": 0.96,
              "easing": "quartInOut"
            },
            {
              "time": 0.5,
              "value": 1,
              "easing": "expoOut"
            }
          ]
        },
        {
          "property": "opacity",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.0,
              "value": 1,
              "easing": "cubicIn"
            },
            {
              "time": 0.32,
              "value": 0,
              "easing": "cubicIn"
            }
          ]
        }
      ]
    },
    {
      "id": "hook_text",
      "type": "text",
      "name": "Hook Text",
      "props": {
        "text": "param:hook",
        "font": "Avenir Next Condensed",
        "font_bn": "token:font_heading_bn",
        "size": 0.058,
        "weight": "Bold",
        "color": [
          0.08,
          0.08,
          0.1,
          1.0
        ],
        "center_x": 0.5,
        "center_y": "param:pos_y",
        "offset_y": 0.05,
        "role": "headline",
        "character_spacing": 1.0,
        "alignment": "center",
        "text_width": 0.76
      },
      "motion_tracks": [
        {
          "property": "opacity",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.015,
              "value": 0,
              "easing": "quartInOut"
            },
            {
              "time": 0.235,
              "value": 1,
              "easing": "quartInOut"
            }
          ]
        },
        {
          "property": "scale",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.015,
              "value": 0.95,
              "easing": "softSpring"
            },
            {
              "time": 0.295,
              "value": 1.025,
              "easing": "softSpring"
            },
            {
              "time": 0.415,
              "value": 1,
              "easing": "softSpring"
            }
          ]
        },
        {
          "property": "opacity",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.0,
              "value": 1,
              "easing": "cubicIn"
            },
            {
              "time": 0.26,
              "value": 0,
              "easing": "cubicIn"
            }
          ]
        }
      ]
    },
    {
      "id": "sub_text",
      "type": "text",
      "name": "Follow-Up Text",
      "props": {
        "text": "param:sub",
        "font": "Avenir",
        "font_bn": "token:font_body_bn",
        "size": 0.038,
        "weight": "Bold",
        "color": "token:text_primary",
        "center_x": 0.5,
        "center_y": "param:pos_y",
        "offset_y": "-0.09",
        "role": "body",
        "character_spacing": 1.0,
        "alignment": "center",
        "text_width": 0.76
      },
      "motion_tracks": [
        {
          "property": "opacity",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.15,
              "value": 0,
              "easing": "quartInOut"
            },
            {
              "time": 0.41,
              "value": 1,
              "easing": "expoOut"
            }
          ]
        },
        {
          "property": "translate_y",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.15,
              "value": 0.018,
              "easing": "expoOut"
            },
            {
              "time": 0.53,
              "value": 0,
              "easing": "expoOut"
            }
          ]
        },
        {
          "property": "opacity",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.0,
              "value": 1,
              "easing": "cubicIn"
            },
            {
              "time": 0.3,
              "value": 0,
              "easing": "cubicIn"
            }
          ]
        },
        {
          "property": "translate_y",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.0,
              "value": 0,
              "easing": "cubicIn"
            },
            {
              "time": 0.3,
              "value": -0.01,
              "easing": "cubicIn"
            }
          ]
        }
      ]
    }
  ]
}
