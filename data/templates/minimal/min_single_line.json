{
  "id": "min_single_line",
  "name": "Single-line Minimal",
  "category": "Minimal Clean",
  "description": "Pure negative space single-line title with subtle tracking expansion.",
  "tags": [
    "minimal",
    "clean",
    "single line",
    "swiss"
  ],
  "duration_default": 4.0,
  "min_hold": 2.0,
  "in_duration": 0.64,
  "out_duration": 0.35,
  "parameters": [
    {
      "id": "text",
      "name": "Title Text",
      "type": "string",
      "default": "LESS IS MORE",
      "category": "Text"
    },
    {
      "id": "pos_y",
      "name": "Vertical Position",
      "type": "number",
      "default": 0.5,
      "min_val": 0.1,
      "max_val": 0.85,
      "step": 0.01,
      "category": "Layout"
    }
  ],
  "layers": [
    {
      "id": "text",
      "type": "text",
      "name": "Text",
      "props": {
        "text": "param:text",
        "font": "Avenir Next",
        "size": 0.08,
        "weight": "Regular",
        "color": [
          0.95,
          0.93,
          0.89,
          1.0
        ],
        "character_spacing": 1.12,
        "font_bn": "token:font_heading_bn",
        "role": "headline",
        "alignment": "center",
        "text_width": 0.76
      },
      "motion_tracks": [
        {
          "property": "opacity",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.015,
              "value": 0,
              "easing": "quartInOut"
            },
            {
              "time": 0.275,
              "value": 1,
              "easing": "expoOut"
            }
          ]
        },
        {
          "property": "translate_y",
          "phase": "in",
          "keyframes": [
            {
              "time": 0.015,
              "value": 0.012,
              "easing": "expoOut"
            },
            {
              "time": 0.395,
              "value": 0,
              "easing": "expoOut"
            }
          ]
        },
        {
          "property": "opacity",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.0,
              "value": 1,
              "easing": "cubicIn"
            },
            {
              "time": 0.3,
              "value": 0,
              "easing": "cubicIn"
            }
          ]
        },
        {
          "property": "translate_y",
          "phase": "out",
          "keyframes": [
            {
              "time": 0.0,
              "value": 0,
              "easing": "cubicIn"
            },
            {
              "time": 0.3,
              "value": -0.01,
              "easing": "cubicIn"
            }
          ]
        }
      ]
    }
  ],
  "aspect_ratios": [
    "16:9",
    "9:16",
    "1:1"
  ]
}
